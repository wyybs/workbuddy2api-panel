# workbuddy2api-panel · 同步配置（被 shell source：路径用正斜杠，多值加引号）

UPSTREAM_URL="https://github.com/misakano7545/workbuddy2api-panel.git"
UPSTREAM_HEAD="main"
LOCAL_BRANCH="local"
CORE_FILES="go.mod internal/server/handler.go internal/pool/pool.go internal/livecfg/livecfg.go"

# 跟随基线：main（本仓库既有约定：main 只做 ff，永远等于 upstream/main）
BASE_REF="main"

PORT_PREFIX="port:"
LOCAL_PREFIX="local:"
VERIFY_CMD="go build ./... && go test ./..."
INSTALL_CMD=""                       # 本项目是独立 Go 二进制，不装进宿主
INSTALL_DIR=""
HARDCODE_PATTERN="misakano7545"      # 写死上游地址/模块路径的检查关键词
